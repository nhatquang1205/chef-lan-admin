# Base URL of the API, WITHOUT the /api suffix. Empty = same origin (dev uses the Vite proxy in
# vite.config.ts, which forwards /api to VITE_DEV_API_TARGET or http://localhost:5059).
# Production (admin on its own subdomain): the public API origin, e.g. https://example.com
VITE_API_BASE_URL=

# Origin of the customer site (no trailing slash), used for "Xem trên trang" links to /courses/{slug}.
# Locally http://localhost:3000. Leave empty to hide those links.
VITE_PUBLIC_SITE_URL=
